new file mode 100644
index 00000000..4a3b8805
--- /dev/null
+++ b/tools/render_sugartv_preview.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+"""Render the exact on-device SugarTV framebuffer without flashing an X3."""
+
+from __future__ import annotations
+
+import argparse
+import math
+import subprocess
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+ROOT = Path(__file__).resolve().parents[1]
+WIDTH = 528
+HEIGHT = 792
+BINARY = Path(tempfile.gettempdir()) / "xteink-sugartv-frame-renderer"
+SOURCES = (
+    ROOT / "tools/render_sugartv_frame.cpp",
+    ROOT / "src/activities/network/SugarTvFrameRenderer.cpp",
+    ROOT / "src/activities/network/SugarTvFrameRenderer.h",
+)
+
+
+@dataclass(frozen=True)
+class FrameOptions:
+    time: str = "21:06"
+    value: str = "116"
+    delta: str | None = "+1"
+    battery: str = "100%"
+    trend: str = "steady"
+    zone: str = "target"
+    age_tier: str = "current"
+    dim_by_age: bool = False
+    show_age_states: bool = False
+    color_thresholds: bool = True
+    prediction: str = ""
+    update_failed: bool = False
+    attempt_time: str = "Aug 9, 3:55 PM"
+    value_point_size: int = 108
+
+
+def _build_renderer() -> None:
+    if BINARY.exists() and BINARY.stat().st_mtime >= max(path.stat().st_mtime for path in SOURCES):
+        return
+    subprocess.run(
+        [
+            "c++",
+            "-std=c++17",
+            "-Wno-c++11-narrowing",
+            "-O2",
+            "-I",
+            str(ROOT / "src"),
+            "-I",
+            str(ROOT / "lib/EpdFont"),
+            "-I",
+            str(ROOT / "lib/EpdFont/builtinFonts"),
+            str(SOURCES[0]),
+            str(SOURCES[1]),
+            "-o",
+            str(BINARY),
+        ],
+        check=True,
+    )
+
+
+def render(_font_path: Path, options: FrameOptions) -> Image.Image:
+    if options.value_point_size != 108:
+        raise ValueError("font size is fixed by the device visual contract")
+    _build_renderer()
+    with tempfile.NamedTemporaryFile(suffix=".pbm") as output:
+        relative = "ago" in options.time or options.time == "now"
+        subprocess.run(
+            [
+                str(BINARY),
+                output.name,
+                options.time,
+                options.value,
+                options.delta if options.delta is not None else "none",
+                options.battery,
+                options.trend,
+                options.zone,
+                options.age_tier,
+                str(int(relative)),
+                str(int(options.show_age_states)),
+                str(int(options.dim_by_age)),
+                str(int(options.color_thresholds)),
+                options.prediction,
+                str(int(options.update_failed)),
+                options.attempt_time,
+            ],
+            check=True,
+            capture_output=True,
+            text=True,
+        )
+        with Image.open(output.name) as image:
+            return image.copy().convert("1", dither=Image.Dither.NONE)
+
+
+def render_matrix(font_path: Path) -> Image.Image:
+    prediction = "Expected to rise 15-30 mg/dL in 15 minutes"
+    cases = [
+        ("Target / steady", FrameOptions()),
+        ("Prediction", FrameOptions(trend="rising_slightly", delta="+8", prediction=prediction)),
+        ("Low warning", FrameOptions(value="68", delta="−4", trend="falling", zone="low")),
+        ("High warning", FrameOptions(value="210", delta="+9", trend="rising", zone="high")),
+        ("Urgent low", FrameOptions(value="48", delta="−12", trend="falling_quickly", zone="urgent_low")),
+        ("Urgent high", FrameOptions(value="286", delta="+22", trend="rising_quickly", zone="urgent_high")),
+        (
+            "Threshold colors disabled",
+            FrameOptions(
+                value="286",
+                delta="+22",
+                trend="rising_quickly",
+                zone="urgent_high",
+                color_thresholds=False,
+            ),
+        ),
+        ("mmol/L", FrameOptions(value="6.4", delta="−0.3", trend="falling_slightly")),
+        ("No history", FrameOptions(delta=None)),
+        ("Unknown trend", FrameOptions(trend="unknown")),
+        ("Unavailable", FrameOptions(value="N/A", delta=None, trend="unknown", age_tier="stale")),
+        ("Aging + dim enabled", FrameOptions(age_tier="aging", dim_by_age=True, show_age_states=True)),
+        ("Aging + dim disabled", FrameOptions(age_tier="aging", dim_by_age=False)),
+        ("Stale + states enabled", FrameOptions(age_tier="stale", show_age_states=True)),
+        ("Relative time", FrameOptions(time="3 min. ago")),
+        ("Update failed", FrameOptions(update_failed=True)),
+    ]
+    scale = 0.5
+    cell_width = round(WIDTH * scale)
+    cell_height = round(HEIGHT * scale)
+    caption_height = 32
+    columns = 4
+    rows = math.ceil(len(cases) / columns)
+    sheet = Image.new("1", (columns * cell_width, rows * (cell_height + caption_height)), 1)
+    draw = ImageDraw.Draw(sheet)
+    caption_font = ImageFont.truetype(str(font_path), 17)
+    for index, (caption, options) in enumerate(cases):
+        x = index % columns * cell_width
+        y = index // columns * (cell_height + caption_height)
+        frame = render(font_path, options).resize((cell_width, cell_height), Image.Resampling.NEAREST)
+        sheet.paste(frame, (x, y))
+        draw.text((x + cell_width // 2, y + cell_height + 4), caption, font=caption_font, fill=0, anchor="ma")
+    return sheet
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--font", type=Path, required=True, help="Used only for matrix captions")
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--matrix", action="store_true")
+    parser.add_argument("--time", default="21:06")
+    parser.add_argument("--value", default="116")
+    parser.add_argument("--delta", default="+1")
+    parser.add_argument("--battery", default="100%")
+    parser.add_argument("--trend", default="steady")
+    parser.add_argument("--zone", default="target")
+    parser.add_argument("--age-tier", default="current")
+    parser.add_argument("--dim-by-age", action="store_true")
+    parser.add_argument("--show-age-states", action="store_true")
+    parser.add_argument("--no-color-thresholds", action="store_true")
+    parser.add_argument("--prediction", default="")
+    parser.add_argument("--update-failed", action="store_true")
+    parser.add_argument("--attempt-time", default="Aug 9, 3:55 PM")
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    options = FrameOptions(
+        time=args.time,
+        value=args.value,
+        delta=args.delta,
+        battery=args.battery,
+        trend=args.trend,
+        zone=args.zone,
+        age_tier=args.age_tier,
+        dim_by_age=args.dim_by_age,
+        show_age_states=args.show_age_states,
+        color_thresholds=not args.no_color_thresholds,
+        prediction=args.prediction,
+        update_failed=args.update_failed,
+        attempt_time=args.attempt_time,
+    )
+    image = render_matrix(args.font) if args.matrix else render(args.font, options)
+    image.save(args.output)
+
+
+if __name__ == "__main__":
+    main()
