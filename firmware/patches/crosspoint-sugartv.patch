+time_t parseTimestampText(const char* text) {
+  if (!text) return 0;
+  while (std::isspace(static_cast<unsigned char>(*text))) ++text;
+  char* numericEnd = nullptr;
+  const double numeric = strtod(text, &numericEnd);
+  if (numericEnd != text) {
+    while (std::isspace(static_cast<unsigned char>(*numericEnd))) ++numericEnd;
+    if (*numericEnd == '\0' && std::isfinite(numeric)) {
+      return static_cast<time_t>(fabs(numeric) < 1.0e11 ? numeric : numeric / 1000.0);
+    }
+  }
+
+  int year = 0;
+  int month = 0;
+  int day = 0;
+  int hour = 0;
+  int minute = 0;
+  int second = 0;
+  int consumed = 0;
+  if (sscanf(text, "%d-%d-%dT%d:%d:%d%n", &year, &month, &day, &hour, &minute, &second, &consumed) != 6)
+    return 0;
+  if (month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month) || hour < 0 || hour > 23 ||
+      minute < 0 || minute > 59 || second < 0 || second > 59)
+    return 0;
+  year -= month <= 2;
+  const int era = (year >= 0 ? year : year - 399) / 400;
+  const unsigned yearOfEra = static_cast<unsigned>(year - era * 400);
+  const unsigned adjustedMonth = static_cast<unsigned>(month + (month > 2 ? -3 : 9));
+  const unsigned dayOfYear = (153 * adjustedMonth + 2) / 5 + static_cast<unsigned>(day) - 1;
+  const unsigned dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear;
+  const int64_t daysSinceEpoch = static_cast<int64_t>(era) * 146097 + dayOfEra - 719468;
+  time_t result = static_cast<time_t>(daysSinceEpoch * 86400 + hour * 3600 + minute * 60 + second);
+
+  const char* suffix = text + consumed;
+  if (*suffix == '.') {
+    ++suffix;
+    if (!std::isdigit(static_cast<unsigned char>(*suffix))) return 0;
+    while (std::isdigit(static_cast<unsigned char>(*suffix))) ++suffix;
+  }
+  if (*suffix == '+' || *suffix == '-') {
+    const int direction = *suffix == '+' ? 1 : -1;
+    if (!std::isdigit(static_cast<unsigned char>(suffix[1])) ||
+        !std::isdigit(static_cast<unsigned char>(suffix[2])) || suffix[3] != ':' ||
+        !std::isdigit(static_cast<unsigned char>(suffix[4])) ||
+        !std::isdigit(static_cast<unsigned char>(suffix[5])) || suffix[6] != '\0')
+      return 0;
+    const int offsetHour = (suffix[1] - '0') * 10 + suffix[2] - '0';
+    const int offsetMinute = (suffix[4] - '0') * 10 + suffix[5] - '0';
+    if (offsetHour > 23 || offsetMinute > 59) return 0;
+    result -= direction * (offsetHour * 3600 + offsetMinute * 60);
+  } else if (*suffix == 'Z' || *suffix == 'z') {
+    if (suffix[1] != '\0') return 0;
+  } else if (*suffix != '\0') {
+    return 0;
+  }
+  return result;
+}
