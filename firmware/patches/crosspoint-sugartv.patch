+#pragma once
+
+#include <EpdFontData.h>
+
+#include <cstdint>
+
+#include "activities/network/SugarTvLogic.h"
+
+namespace sugartv {
+
+constexpr int FRAME_WIDTH = 528;
+constexpr int FRAME_HEIGHT = 792;
+
+struct FrameFonts {
+  const EpdFontData* value;
+  const EpdFontData* delta;
+  const EpdFontData* relative;
+  const EpdFontData* prediction;
+  const EpdFontData* battery;
+};
+
+struct FrameContent {
+  const char* timeText;
+  const char* valueText;
+  const char* deltaText;
+  const char* predictionText;
+  const char* batteryText;
+  const char* attemptText;
+  Trend trend;
+  GlucoseZone zone;
+  AgeTier ageTier;
+  bool relativeTime;
+  bool showAgeStates;
+  bool dimByAge;
+  bool colorThresholds;
+};
+
+struct FrameStats {
+  int minX = FRAME_WIDTH;
+  int minY = FRAME_HEIGHT;
+  int maxX = -1;
+  int maxY = -1;
+  uint32_t clippedPixels = 0;
+};
+
+class FrameCanvas {
+ public:
+  virtual ~FrameCanvas() = default;
+  virtual void clear(bool ink) = 0;
+  virtual void setPixel(int x, int y, bool ink) = 0;
+  virtual bool isInk(int x, int y) const = 0;
+};
+
+FrameStats renderFrame(FrameCanvas& canvas, const FrameFonts& fonts, const FrameContent& content);
+
+}  // namespace sugartv
