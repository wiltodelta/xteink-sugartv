+
+#ifndef SUGARTV_HA_URL
+#error "SUGARTV_HA_URL must be defined"
+#endif
+#ifndef SUGARTV_HA_TOKEN
+#error "SUGARTV_HA_TOKEN must be defined"
+#endif
+#ifndef SUGARTV_TZ
+#define SUGARTV_TZ "UTC0"
+#endif
+
+namespace {
+constexpr uint64_t REFRESH_SECONDS = 60;
+constexpr char SUGARTV_DIRECTORY[] = "/.crosspoint";
+constexpr char ENTITY_CACHE_PATH[] = "/.crosspoint/sugartv-entity.txt";
+constexpr char READING_CACHE_PATH[] = "/.crosspoint/sugartv-reading.json";
+constexpr char SETTINGS_PATH[] = "/.crosspoint/sugartv.json";
+constexpr size_t MAX_ENTITY_ID_LENGTH = 159;
+constexpr size_t MAX_STATE_OBJECT_SIZE = 8192;
+constexpr size_t MAX_SETTINGS_SIZE = 2048;
+enum class StateReadResult { Ok, Unavailable, RequestFailed };
+using sugartv::AgeTier;
+using sugartv::GlucoseZone;
+using sugartv::GlucoseThresholds;
+using sugartv::Trend;
+using sugartv::ageTier;
+using sugartv::cadenceFromTimestamps;
+using sugartv::glucoseZone;
+using sugartv::normalizeTrend;
+using sugartv::parseTimestampText;
+using sugartv::siblingEntityId;
+using sugartv::thresholdsForUnit;
+
+struct HistoryPoint {
+  float value;
+  time_t timestamp;
+};
+
+struct Reading {
+  bool valid = false;
+  float value = 0;
+  bool mmol = false;
+  Trend trend = Trend::Unknown;
+  time_t measuredAt = 0;
+  bool hasDelta = false;
+  float delta = 0;
+  float cadenceSeconds = 0;
+  time_t updatedAt = 0;
+  uint16_t batteryPercentage = 0;
+};
+
+struct CardConfig {
+  std::string glucoseEntity;
+  std::string trendEntity;
+  std::string timestampAttribute;
+  bool showPrediction = true;
+  bool relativeTime = true;
+  bool dimByAge = false;
+  bool showAgeStates = false;
+  bool colorThresholds = false;
+  bool decimalComma = false;
+  GlucoseThresholds thresholdOverrides = {NAN, NAN, NAN, NAN};
+};
+
+std::string apiUrl(const std::string& path) {
+  std::string base = SUGARTV_HA_URL;
+  while (!base.empty() && base.back() == '/') base.pop_back();
+  return base + path;
+}
+
+bool isValidEntityId(const std::string& entityId) {
+  if (entityId.size() < 8 || entityId.size() > MAX_ENTITY_ID_LENGTH || entityId.rfind("sensor.", 0) != 0) return false;
+  return std::all_of(entityId.begin(), entityId.end(), [](unsigned char c) {
+    return std::islower(c) || std::isdigit(c) || c == '_' || c == '.';
+  });
+}
+
+bool writeSugarTvCache(const char* path, const String& content) {
+  Storage.ensureDirectoryExists(SUGARTV_DIRECTORY);
+  return Storage.writeFile(path, content);
+}
+
+bool readCachedEntity(std::string& entityId) {
+  char buffer[MAX_ENTITY_ID_LENGTH + 2] = {};
+  const size_t length = Storage.readFileToBuffer(ENTITY_CACHE_PATH, buffer, sizeof(buffer));
+  if (length == 0) return false;
+  entityId.assign(buffer, length);
+  while (!entityId.empty() && std::isspace(static_cast<unsigned char>(entityId.back()))) entityId.pop_back();
+  return isValidEntityId(entityId);
+}
+
+bool saveCachedEntity(const std::string& entityId) {
+  if (!isValidEntityId(entityId)) return false;
+  return writeSugarTvCache(ENTITY_CACHE_PATH, String(entityId.c_str()));
+}
+
+bool loadCachedReading(Reading& reading) {
+  char buffer[512] = {};
+  const size_t length = Storage.readFileToBuffer(READING_CACHE_PATH, buffer, sizeof(buffer));
+  if (length == 0) return false;
+  JsonDocument cache;
+  if (deserializeJson(cache, buffer, length)) return false;
+  const int trend = cache["trend"] | static_cast<int>(Trend::Unknown);
+  if (trend < static_cast<int>(Trend::RisingQuickly) || trend > static_cast<int>(Trend::Unknown)) return false;
+  reading.valid = cache["valid"] | false;
+  reading.value = cache["value"] | 0.0F;
+  reading.mmol = cache["mmol"] | false;
+  reading.trend = static_cast<Trend>(trend);
+  reading.measuredAt = static_cast<time_t>(cache["measured_at"] | 0LL);
+  reading.hasDelta = cache["has_delta"] | false;
+  reading.delta = cache["delta"] | 0.0F;
+  reading.cadenceSeconds = cache["cadence_seconds"] | 0.0F;
+  reading.updatedAt = static_cast<time_t>(cache["updated_at"] | 0LL);
+  if (cache["battery_percentage"].is<uint16_t>())
+    reading.batteryPercentage = cache["battery_percentage"].as<uint16_t>();
+  else
+    reading.batteryPercentage = powerManager.getBatteryPercentage();
+  return reading.valid;
+}
+
+void loadCachedReadingOrFallback(Reading& reading) {
+  if (!loadCachedReading(reading)) reading.batteryPercentage = powerManager.getBatteryPercentage();
+}
+
+bool saveCachedReading(const Reading& reading) {
+  if (!reading.valid) return false;
+  JsonDocument cache;
+  cache["valid"] = reading.valid;
+  cache["value"] = reading.value;
+  cache["mmol"] = reading.mmol;
+  cache["trend"] = static_cast<int>(reading.trend);
+  cache["measured_at"] = static_cast<int64_t>(reading.measuredAt);
+  cache["has_delta"] = reading.hasDelta;
+  cache["delta"] = reading.delta;
+  cache["cadence_seconds"] = reading.cadenceSeconds;
+  cache["updated_at"] = static_cast<int64_t>(reading.updatedAt);
+  cache["battery_percentage"] = reading.batteryPercentage;
+  String serialized;
+  serializeJson(cache, serialized);
+  return writeSugarTvCache(READING_CACHE_PATH, serialized);
+}
+
+void loadSettings(CardConfig& config) {
+  char buffer[MAX_SETTINGS_SIZE + 1] = {};
+  const size_t length = Storage.readFileToBuffer(SETTINGS_PATH, buffer, sizeof(buffer));
+  if (length == 0) return;
+
+  JsonDocument settings;
+  const DeserializationError error = deserializeJson(settings, buffer, length);
+  if (error) {
+    LOG_ERR("SUGARTV", "Invalid %s: %s", SETTINGS_PATH, error.c_str());
+    return;
+  }
+
+  const char* glucoseEntity = settings["glucose_value"];
+  if (glucoseEntity && isValidEntityId(glucoseEntity)) config.glucoseEntity = glucoseEntity;
+  const char* trendEntity = settings["glucose_trend"];
+  if (trendEntity && isValidEntityId(trendEntity)) config.trendEntity = trendEntity;
+  const char* timestampAttribute = settings["timestamp_attribute"];
+  if (timestampAttribute && *timestampAttribute) config.timestampAttribute = timestampAttribute;
+  config.showPrediction = settings["show_prediction"] | config.showPrediction;
+  config.relativeTime = settings["relative_time"] | config.relativeTime;
+  config.dimByAge = settings["dim_by_age"] | config.dimByAge;
+  config.showAgeStates = settings["show_age_states"] | config.showAgeStates;
+  config.colorThresholds = settings["color_thresholds"] | config.colorThresholds;
+  config.decimalComma = settings["decimal_comma"] | config.decimalComma;
+
+  JsonObjectConst thresholds = settings["thresholds"];
+  if (thresholds.isNull()) return;
+  if (thresholds["urgent_low"].is<float>()) config.thresholdOverrides.urgentLow = thresholds["urgent_low"];
+  if (thresholds["low"].is<float>()) config.thresholdOverrides.low = thresholds["low"];
+  if (thresholds["high"].is<float>()) config.thresholdOverrides.high = thresholds["high"];
+  if (thresholds["urgent_high"].is<float>()) config.thresholdOverrides.urgentHigh = thresholds["urgent_high"];
+}
+
+bool discoverGlucoseEntity(std::string& entityId) {
+  std::string object;
+  object.reserve(1024);
+  int depth = 0;
+  bool inString = false;
+  bool escaped = false;
+  bool overflow = false;
+  bool found = false;
+
+  const auto inspectObject = [&]() {
+    if (overflow || object.empty()) return;
+    JsonDocument state;
+    if (deserializeJson(state, object)) return;
+    const char* candidate = state["entity_id"];
+    const char* deviceClass = state["attributes"]["device_class"];
+    if (!candidate || !deviceClass || strcmp(deviceClass, "blood_glucose_concentration") != 0) return;
+    const std::string value(candidate);
+    if (!isValidEntityId(value)) return;
+    entityId = value;
+    found = true;
+  };
+
+  HttpDownloader::fetchUrl(
+      apiUrl("/api/states"),
+      [&](const uint8_t* data, size_t length) {
+        for (size_t i = 0; i < length; ++i) {
+          const char c = static_cast<char>(data[i]);
+          if (depth == 0) {
+            if (c != '{') continue;
+            object.clear();
+            overflow = false;
+            depth = 1;
+            inString = false;
+            escaped = false;
+            object.push_back(c);
+            continue;
+          }
+
+          if (!overflow) {
+            if (object.size() >= MAX_STATE_OBJECT_SIZE)
+              overflow = true;
+            else
+              object.push_back(c);
+          }
+          if (inString) {
+            if (escaped)
+              escaped = false;
+            else if (c == '\\')
+              escaped = true;
+            else if (c == '"')
+              inString = false;
+          } else if (c == '"') {
+            inString = true;
+          } else if (c == '{') {
+            ++depth;
+          } else if (c == '}' && --depth == 0) {
+            inspectObject();
+            if (found) return false;
+          }
+        }
+        return true;
+      },
+      "", "", SUGARTV_HA_TOKEN);
+
+  if (!found) {
+    LOG_ERR("SUGARTV", "No blood glucose sensor was found");
+    return false;
+  }
+  LOG_INF("SUGARTV", "Discovered glucose sensor: %s", entityId.c_str());
+  if (!saveCachedEntity(entityId)) LOG_ERR("SUGARTV", "Could not cache the glucose sensor");
+  return true;
+}
+
+bool loadGlucoseEntity(CardConfig& config) {
+  if (isValidEntityId(config.glucoseEntity)) return true;
+  if (readCachedEntity(config.glucoseEntity)) return true;
+  return discoverGlucoseEntity(config.glucoseEntity);
+}
+
+bool fetchJson(const std::string& path, JsonDocument& doc) {
+  std::string body;
+  if (!HttpDownloader::fetchUrl(apiUrl(path), body, "", "", SUGARTV_HA_TOKEN)) return false;
+  const DeserializationError error = deserializeJson(doc, body);
+  if (error) {
+    LOG_ERR("SUGARTV", "Invalid Home Assistant JSON: %s", error.c_str());
+    return false;
+  }
+  return true;
+}
+
+time_t parseTimestamp(JsonVariantConst value) {
+  if (value.isNull()) return 0;
+  if (value.is<double>()) {
+    const double numeric = value.as<double>();
+    if (!std::isfinite(numeric)) return 0;
+    return static_cast<time_t>(fabs(numeric) < 1.0e11 ? numeric : numeric / 1000.0);
+  }
+  return parseTimestampText(value.as<const char*>());
+}
+
+bool readTrendEntity(const std::string& entityId, Trend& trend) {
+  if (entityId.empty()) return false;
+  JsonDocument trendDoc;
+  if (!fetchJson(std::string("/api/states/") + entityId, trendDoc)) return false;
+  trend = normalizeTrend(trendDoc["state"]);
+  return true;
+}
+
+Trend resolveTrend(const CardConfig& config, JsonObjectConst glucoseState) {
+  if (!config.trendEntity.empty()) {
+    Trend trend;
+    if (readTrendEntity(config.trendEntity, trend)) return trend;
+  }
+
+  constexpr const char* SIBLING_PATTERNS[][2] = {
+      {"glucose_value", "glucose_trend"},
+      {"last_glucose_level_mg_dl", "last_glucose_trend"},
+      {"last_glucose_level_mmol", "last_glucose_trend"},
+      {"last_sg_mgdl", "last_sg_trend"},
+      {"last_sg_mmol", "last_sg_trend"},
+  };
+  for (const auto& pattern : SIBLING_PATTERNS) {
+    Trend trend;
+    if (readTrendEntity(siblingEntityId(config.glucoseEntity, pattern[0], pattern[1]), trend)) return trend;
+  }
+
+  const size_t underscore = config.glucoseEntity.rfind('_');
+  if (underscore != std::string::npos) {
+    Trend trend;
+    if (readTrendEntity(config.glucoseEntity.substr(0, underscore) + "_trend", trend)) return trend;
+  }
+
+  const char* direction = glucoseState["attributes"]["direction"];
+  if (direction && *direction) return normalizeTrend(direction);
+  return normalizeTrend(glucoseState["attributes"]["trend"]);
+}
+
+const char* timestampFromState(JsonObjectConst state) {
+  const char* value = state["last_updated"];
+  if (!value) value = state["last_changed"];
+  return value;
+}
+
+time_t timestampFromSibling(const std::string& glucoseEntity) {
+  constexpr const char* TIMESTAMP_SIBLINGS[][2] = {
+      {"last_glucose_level_mg_dl", "last_glucose_update"},
+      {"last_glucose_level_mmol", "last_glucose_update"},
+  };
+  for (const auto& pattern : TIMESTAMP_SIBLINGS) {
+    const std::string entity = siblingEntityId(glucoseEntity, pattern[0], pattern[1]);
+    if (entity.empty()) continue;
+    JsonDocument sibling;
+    if (!fetchJson(std::string("/api/states/") + entity, sibling)) continue;
+    const time_t parsed = parseTimestamp(sibling["state"]);
+    if (parsed != 0) return parsed;
+  }
+
+  const std::string ageEntity = siblingEntityId(glucoseEntity, "glucose_measurement", "minutes_since_update");
+  if (ageEntity.empty()) return 0;
+  JsonDocument sibling;
+  if (!fetchJson(std::string("/api/states/") + ageEntity, sibling)) return 0;
+  const char* rawMinutes = sibling["state"];
+  char* end = nullptr;
+  const double minutes = rawMinutes ? strtod(rawMinutes, &end) : NAN;
+  if (end == rawMinutes || *end != '\0' || !std::isfinite(minutes) || minutes < 0 || minutes > 15) return 0;
+  const time_t reportedAt = parseTimestampText(timestampFromState(sibling.as<JsonObjectConst>()));
+  return reportedAt == 0 ? 0 : reportedAt - static_cast<time_t>(minutes * 60.0);
+}
+
+bool hasJsonKey(JsonObjectConst object, const char* key) {
+  for (JsonPairConst pair : object) {
+    if (strcmp(pair.key().c_str(), key) == 0) return true;
+  }
+  return false;
+}
+
+time_t resolveTimestamp(const CardConfig& config, JsonObjectConst glucoseState) {
+  JsonObjectConst attributes = glucoseState["attributes"];
+  if (!config.timestampAttribute.empty()) {
+    const time_t configured = parseTimestamp(attributes[config.timestampAttribute]);
+    if (configured != 0) return configured;
+  } else {
+    const time_t measurement = parseTimestamp(attributes["measurement_timestamp"]);
+    if (measurement != 0) return measurement;
+
+    const bool looksLikeNightscout = strcmp(attributes["device_class"] | "", "blood_glucose_concentration") == 0 &&
+                                     hasJsonKey(attributes, "date") && hasJsonKey(attributes, "direction") &&
+                                     hasJsonKey(attributes, "delta");
+    if (looksLikeNightscout) {
+      const time_t nightscout = parseTimestamp(attributes["date"]);
+      if (nightscout != 0) return nightscout;
+    }
+
+    const time_t sibling = timestampFromSibling(config.glucoseEntity);
+    if (sibling != 0) return sibling;
+  }
+  return parseTimestampText(timestampFromState(glucoseState));
+}
+
+StateReadResult readCurrentState(const CardConfig& config, Reading& reading) {
+  JsonDocument stateDoc;
+  if (!fetchJson(std::string("/api/states/") + config.glucoseEntity, stateDoc)) return StateReadResult::RequestFailed;
+  const char* stateText = stateDoc["state"];
+  const char* unit = stateDoc["attributes"]["unit_of_measurement"] | "mg/dL";
+  reading.mmol = strcasecmp(unit, "mmol/L") == 0;
+  reading.measuredAt = resolveTimestamp(config, stateDoc.as<JsonObjectConst>());
+  reading.trend = resolveTrend(config, stateDoc.as<JsonObjectConst>());
+
+  if (!stateText || strcmp(stateText, "unknown") == 0 || strcmp(stateText, "unavailable") == 0)
+    return StateReadResult::Unavailable;
+  char* end = nullptr;
+  reading.value = strtof(stateText, &end);
+  if (end == stateText || *end != '\0') return StateReadResult::Unavailable;
+  reading.valid = true;
+  return StateReadResult::Ok;
+}
+
+std::string formatUtc(time_t value) {
+  struct tm utc = {};
+  gmtime_r(&value, &utc);
+  char text[24];
+  strftime(text, sizeof(text), "%Y-%m-%dT%H:%M:%SZ", &utc);
+  return text;
+}
+
+void readHistory(const CardConfig& config, Reading& reading) {
+  if (!reading.valid || reading.measuredAt == 0) return;
+  const time_t start = reading.measuredAt - 25 * 60;
+  const time_t end = reading.measuredAt + 60;
+  std::string path = "/api/history/period/" + formatUtc(start) + "?filter_entity_id=" + config.glucoseEntity +
+                     "&end_time=" + formatUtc(end) +
+                     "&minimal_response=true&no_attributes=true&significant_changes_only=false";
+  JsonDocument historyDoc;
+  if (!fetchJson(path, historyDoc)) return;
+  JsonArrayConst series = historyDoc[0];
+  if (series.isNull()) return;
+
+  std::vector<HistoryPoint> points;
+  points.reserve(series.size());
+  for (JsonObjectConst state : series) {
+    const char* raw = state["state"];
+    char* valueEnd = nullptr;
+    const float value = raw ? strtof(raw, &valueEnd) : 0;
+    const time_t timestamp = parseTimestampText(timestampFromState(state));
+    if (raw && valueEnd != raw && *valueEnd == '\0' && timestamp != 0) points.push_back({value, timestamp});
+  }
+  if (points.empty()) return;
+
+  std::vector<time_t> timestamps;
+  timestamps.reserve(points.size());
+  for (const auto& point : points) timestamps.push_back(point.timestamp);
+  reading.cadenceSeconds = cadenceFromTimestamps(std::move(timestamps));
+
+  const time_t target = reading.measuredAt - 5 * 60;
+  const HistoryPoint* best = nullptr;
+  time_t bestDistance = 0;
+  for (const auto& point : points) {
+    if (std::abs(static_cast<long>(point.timestamp - reading.measuredAt)) < 1) continue;
+    const time_t distance = std::abs(static_cast<long>(point.timestamp - target));
+    if (!best || distance < bestDistance) {
+      best = &point;
+      bestDistance = distance;
+    }
+  }
+  if (!best || std::abs(static_cast<long>(reading.measuredAt - best->timestamp)) >= 9 * 60) return;
+  const float difference = reading.value - best->value;
+  reading.delta = reading.mmol ? roundf(difference * 10.0F) / 10.0F : roundf(difference);
+  reading.hasDelta = true;
+}
+
+void thresholdsFor(const CardConfig& config, const Reading& reading, float& urgentLow, float& low, float& high,
+                   float& urgentHigh) {
+  const GlucoseThresholds thresholds = thresholdsForUnit(reading.mmol, config.thresholdOverrides);
+  urgentLow = thresholds.urgentLow;
+  low = thresholds.low;
+  high = thresholds.high;
+  urgentHigh = thresholds.urgentHigh;
+}
+
+const char* predictionText(const CardConfig& config, const Reading& reading) {
+  if (reading.mmol) {
+    switch (reading.trend) {
+      case Trend::RisingQuickly:
+        return config.decimalComma ? "Expected to rise over 2,5 mmol/L in 15 minutes"
+                                   : "Expected to rise over 2.5 mmol/L in 15 minutes";
+      case Trend::Rising:
+        return config.decimalComma ? "Expected to rise 1,7-2,5 mmol/L in 15 minutes"
+                                   : "Expected to rise 1.7-2.5 mmol/L in 15 minutes";
+      case Trend::RisingSlightly:
+        return config.decimalComma ? "Expected to rise 0,8-1,7 mmol/L in 15 minutes"
+                                   : "Expected to rise 0.8-1.7 mmol/L in 15 minutes";
+      case Trend::FallingSlightly:
+        return config.decimalComma ? "Expected to fall 0,8-1,7 mmol/L in 15 minutes"
+                                   : "Expected to fall 0.8-1.7 mmol/L in 15 minutes";
+      case Trend::Falling:
+        return config.decimalComma ? "Expected to fall 1,7-2,5 mmol/L in 15 minutes"
+                                   : "Expected to fall 1.7-2.5 mmol/L in 15 minutes";
+      case Trend::FallingQuickly:
+        return config.decimalComma ? "Expected to fall over 2,5 mmol/L in 15 minutes"
+                                   : "Expected to fall over 2.5 mmol/L in 15 minutes";
+      default: return "";
+    }
+  }
+  switch (reading.trend) {
+    case Trend::RisingQuickly: return "Expected to rise over 45 mg/dL in 15 minutes";
+    case Trend::Rising: return "Expected to rise 30-45 mg/dL in 15 minutes";
+    case Trend::RisingSlightly: return "Expected to rise 15-30 mg/dL in 15 minutes";
+    case Trend::FallingSlightly: return "Expected to fall 15-30 mg/dL in 15 minutes";
+    case Trend::Falling: return "Expected to fall 30-45 mg/dL in 15 minutes";
+    case Trend::FallingQuickly: return "Expected to fall over 45 mg/dL in 15 minutes";
+    default: return "";
+  }
+}
+
+class DeviceFrameCanvas final : public sugartv::FrameCanvas {
+ public:
+  explicit DeviceFrameCanvas(GfxRenderer& renderer) : renderer(renderer) {}
+
+  void clear(const bool ink) override { renderer.clearScreen(ink ? 0x00 : 0xFF); }
+  void setPixel(const int x, const int y, const bool ink) override { renderer.drawPixel(x, y, ink); }
+  bool isInk(const int x, const int y) const override {
+    const int physicalX = y;
+    const int physicalY = sugartv::FRAME_WIDTH - 1 - x;
+    const uint8_t* framebuffer = renderer.getFrameBuffer();
+    const uint8_t byte = framebuffer[physicalY * renderer.getDisplayWidthBytes() + physicalX / 8];
+    return (byte & (1U << (7 - physicalX % 8))) == 0;
+  }
+
+  uint32_t crc32() const {
+    uint32_t crc = 0xFFFFFFFFU;
+    for (int y = 0; y < sugartv::FRAME_HEIGHT; ++y) {
+      for (int x = 0; x < sugartv::FRAME_WIDTH; ++x) {
+        crc ^= static_cast<uint8_t>(isInk(x, y));
+        for (int bit = 0; bit < 8; ++bit) crc = (crc >> 1) ^ (0xEDB88320U & (0U - (crc & 1U)));
+      }
+    }
+    return ~crc;
+  }
+
+ private:
+  GfxRenderer& renderer;
+};
+
+void formatAttemptTime(const time_t value, char* text, const size_t size) {
+  if (value < 1700000000) {
+    strlcpy(text, "N/A", size);
+    return;
+  }
+  static constexpr const char* MONTHS[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun",
+                                           "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
+  struct tm local = {};
+  localtime_r(&value, &local);
+  const int hour = local.tm_hour % 12 == 0 ? 12 : local.tm_hour % 12;
+  snprintf(text, size, "%s %d, %d:%02d %s", MONTHS[local.tm_mon], local.tm_mday, hour, local.tm_min,
+           local.tm_hour < 12 ? "AM" : "PM");
+}
+
+void renderReading(GfxRenderer& renderer, const CardConfig& config, const Reading& reading, const bool updateFailed,
+                   const time_t attemptedAt) {
+  setenv("TZ", SUGARTV_TZ, 1);
+  tzset();
+  const time_t displayTime = updateFailed && reading.updatedAt != 0 ? reading.updatedAt : attemptedAt;
+  char timeText[32] = "00:00";
+  if (config.relativeTime) {
+    time_t now = displayTime;
+    if (now < reading.measuredAt) now = reading.measuredAt;
+    const long ageMinutes = reading.measuredAt == 0 ? 0 : lround(static_cast<double>(now - reading.measuredAt) / 60.0);
+    if (reading.measuredAt == 0) {
+      strlcpy(timeText, "00:00", sizeof(timeText));
+    } else if (ageMinutes < 1) {
+      strlcpy(timeText, "now", sizeof(timeText));
+    } else if (ageMinutes < 60) {
+      snprintf(timeText, sizeof(timeText), "%ld min. ago", ageMinutes);
+    } else {
+      snprintf(timeText, sizeof(timeText), "%ld hr. ago", lround(static_cast<double>(ageMinutes) / 60.0));
+    }
+  } else if (reading.measuredAt != 0) {
+    struct tm local = {};
+    localtime_r(&reading.measuredAt, &local);
+    strftime(timeText, sizeof(timeText), "%H:%M", &local);
+  }
+
+  char valueText[16];
+  if (!reading.valid) {
+    strlcpy(valueText, "N/A", sizeof(valueText));
+  } else if (reading.mmol) {
+    snprintf(valueText, sizeof(valueText), "%.1f", reading.value);
+  } else {
+    snprintf(valueText, sizeof(valueText), "%.0f", reading.value);
+  }
+  if (config.decimalComma) {
+    char* separator = strchr(valueText, '.');
+    if (separator) *separator = ',';
+  }
+
+  char deltaText[16];
+  const char* delta = nullptr;
+  if (reading.hasDelta) {
+    if (reading.delta == 0) {
+      snprintf(deltaText, sizeof(deltaText), reading.mmol ? "%.1f" : "%.0f", fabsf(reading.delta));
+    } else {
+      snprintf(deltaText, sizeof(deltaText), reading.mmol ? "%s%.1f" : "%s%.0f", reading.delta > 0 ? "+" : "−",
+               fabsf(reading.delta));
+    }
+    if (config.decimalComma) {
+      char* separator = strchr(deltaText, '.');
+      if (separator) *separator = ',';
+    }
+    delta = deltaText;
+  }
+
+  float urgentLow, low, high, urgentHigh;
+  thresholdsFor(config, reading, urgentLow, low, high, urgentHigh);
+  const GlucoseZone zone = reading.valid
+                                 ? glucoseZone(reading.value, urgentLow, low, high, urgentHigh, config.colorThresholds)
+                                 : GlucoseZone::Target;
+  char batteryText[5];
+  snprintf(batteryText, sizeof(batteryText), "%u%%", static_cast<unsigned>(reading.batteryPercentage));
+  char attemptText[24];
+  const char* failureAttemptText = nullptr;
+  if (updateFailed) {
+    formatAttemptTime(attemptedAt, attemptText, sizeof(attemptText));
+    failureAttemptText = attemptText;
+  }
+  const char* prediction = config.showPrediction ? predictionText(config, reading) : "";
+  DeviceFrameCanvas canvas(renderer);
+  const sugartv::FrameFonts fonts{&::sugartv_value_108, &::sugartv_delta_34, &::sugartv_relative_18,
+                                 &::sugartv_prediction_14, &::sugartv_battery_8};
+  const sugartv::FrameContent content{timeText,
+                                     valueText,
+                                     delta,
+                                     prediction,
+                                     batteryText,
+                                     failureAttemptText,
+                                     reading.trend,
+                                     zone,
+                                     ageTier(reading.measuredAt, reading.cadenceSeconds, displayTime),
+                                     config.relativeTime,
+                                     config.showAgeStates,
+                                     config.dimByAge,
+                                     config.colorThresholds};
+  const sugartv::FrameStats stats = sugartv::renderFrame(canvas, fonts, content);
+  if (stats.clippedPixels != 0)
+    LOG_ERR("SUGARTV", "Frame clipped %u pixels", static_cast<unsigned>(stats.clippedPixels));
+  LOG_INF("SUGARTV", "Frame CRC32 %08X, bounds %d,%d-%d,%d", static_cast<unsigned>(canvas.crc32()), stats.minX,
+          stats.minY, stats.maxX, stats.maxY);
+  renderer.displayBuffer(HalDisplay::HALF_REFRESH);
+}
+
+void renderFailedUpdate(GfxRenderer& renderer, const time_t attemptedAt) {
+  CardConfig config;
+  loadSettings(config);
+  Reading reading;
+  loadCachedReadingOrFallback(reading);
+  renderReading(renderer, config, reading, true, attemptedAt);
+}
+}  // namespace
+
+extern void enterSugarTvSleep(uint64_t seconds);
+
+void SugarTvActivity::onEnter() {
+  Activity::onEnter();
+  cycleStartedAtMs = millis();
+  renderer.setOrientation(GfxRenderer::Orientation::Portrait);
+  state = State::Connecting;
+  if (!silent) requestUpdate();
+  startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput, true, silent),
+                         [this](const ActivityResult& result) {
+                           if (result.isCancelled) {
+                             if (silent) {
+                               RenderLock lock(*this);
+                               renderFailedUpdate(renderer, time(nullptr));
+                               enterSugarTvSleep(REFRESH_SECONDS);
+                             } else {
+                               onGoHome();
+                             }
+                             return;
+                           }
+                           state = State::Downloading;
+                           downloadPending = true;
+                           if (!silent) requestUpdate();
+                         });
+}
+
+void SugarTvActivity::onExit() {
+  renderer.setOrientation(GfxRenderer::Orientation::Portrait);
+  Activity::onExit();
+}
+
+void SugarTvActivity::loop() {
+  if (mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    onGoHome();
+    return;
+  }
+  if (!downloadPending) return;
+  downloadPending = false;
+  if (!silent) requestUpdateAndWait();
+  downloadAndDisplay();
+}
+
+void SugarTvActivity::downloadAndDisplay() {
+  if (time(nullptr) < 1700000000) halClock.syncFromNTP();
+  CardConfig config;
+  loadSettings(config);
+  Reading reading;
+  StateReadResult stateResult = StateReadResult::RequestFailed;
+  if (loadGlucoseEntity(config)) {
+    stateResult = readCurrentState(config, reading);
+    if (stateResult == StateReadResult::RequestFailed) {
+      std::string rediscoveredEntity;
+      if (discoverGlucoseEntity(rediscoveredEntity)) {
+        config.glucoseEntity = rediscoveredEntity;
+        stateResult = readCurrentState(config, reading);
+      }
+    }
+  }
+  const bool stateOk = stateResult == StateReadResult::Ok;
+  if (stateOk) readHistory(config, reading);
+  if (stateResult == StateReadResult::Unavailable)
+    LOG_INF("SUGARTV", "Glucose reading is unavailable; keeping sensor %s", config.glucoseEntity.c_str());
+  else if (!stateOk)
+    LOG_ERR("SUGARTV", "Home Assistant reading failed");
+  const time_t attemptedAt = time(nullptr);
+  if (stateOk) {
+    reading.updatedAt = attemptedAt;
+    reading.batteryPercentage = powerManager.getBatteryPercentage();
+    if (!saveCachedReading(reading)) LOG_ERR("SUGARTV", "Could not cache the latest reading");
+  } else {
+    loadCachedReadingOrFallback(reading);
+  }
+  {
+    RenderLock lock(*this);
+    renderReading(renderer, config, reading, !stateOk, attemptedAt);
+  }
+  const uint64_t elapsedSeconds = (millis() - cycleStartedAtMs + 999) / 1000;
+  enterSugarTvSleep(elapsedSeconds < REFRESH_SECONDS ? REFRESH_SECONDS - elapsedSeconds : 1);
+}
+
+void SugarTvActivity::render(RenderLock&&) {
+  if (silent) return;
+  renderer.clearScreen();
+  const char* message = state == State::Downloading ? "Updating SugarTV..." : "Connecting to Wi-Fi...";
+  const auto lineHeight = renderer.getLineHeight(UI_10_FONT_ID);
+  renderer.drawCenteredText(UI_10_FONT_ID, (renderer.getScreenHeight() - lineHeight) / 2, message, true);
+  renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+}
