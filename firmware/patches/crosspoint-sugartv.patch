@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Exercise the firmware's streaming state discovery against a JSON payload."""
+
+from __future__ import annotations
+
+import json
+import random
+import sys
+
+MAX_OBJECT_SIZE = 8192
+
+
+def discover(chunks: list[bytes]) -> str | None:
+    object_bytes = bytearray()
+    depth = 0
+    in_string = False
+    escaped = False
+    overflow = False
+    for chunk in chunks:
+        for byte in chunk:
+            char = chr(byte)
+            if depth == 0:
+                if char != "{":
+                    continue
+                object_bytes.clear()
+                overflow = False
+                depth = 1
+                in_string = False
+                escaped = False
+                object_bytes.append(byte)
+                continue
+
+            if not overflow:
+                if len(object_bytes) >= MAX_OBJECT_SIZE:
+                    overflow = True
+                else:
+                    object_bytes.append(byte)
+            if in_string:
+                if escaped:
+                    escaped = False
+                elif char == "\\":
+                    escaped = True
+                elif char == '"':
+                    in_string = False
+            elif char == '"':
+                in_string = True
+            elif char == "{":
+                depth += 1
+            elif char == "}":
+                depth -= 1
+                if depth == 0 and not overflow:
+                    item = json.loads(object_bytes)
+                    if item.get("attributes", {}).get("device_class") == "blood_glucose_concentration":
+                        return item["entity_id"]
+    return None
+
+
+def chunks_for(payload: bytes, rng: random.Random) -> list[bytes]:
+    chunks = []
+    cursor = 0
+    while cursor < len(payload):
+        size = rng.randint(1, 4096)
+        chunks.append(payload[cursor : cursor + size])
+        cursor += size
+    return chunks
+
+
+def main() -> None:
+    payload = sys.stdin.buffer.read()
+    expected = [
+        item["entity_id"]
+        for item in json.loads(payload)
+        if item.get("attributes", {}).get("device_class") == "blood_glucose_concentration"
+    ]
+    assert len(expected) == 1, expected
+
+    rng = random.Random(0x5833)
+    for _ in range(100):
+        assert discover(chunks_for(payload, rng)) == expected[0]
+    sys.stdout.write(
+        f"live discovery: 100/100 randomized chunkings, {len(payload)} bytes, source={expected[0]}\n"
+    )
+
+
+if __name__ == "__main__":
+    main()
