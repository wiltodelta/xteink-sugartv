@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Visual contract tests for the on-device SugarTV preview."""
+
+from __future__ import annotations
+
+import hashlib
+import re
+import sys
+import unittest
+from pathlib import Path
+
+from PIL import Image, ImageChops
+
+sys.path.insert(0, str(Path(__file__).parent))
+
+from render_sugartv_preview import FrameOptions, render, render_matrix  # noqa: E402
+
+
+ROOT = Path(__file__).resolve().parents[1]
+FONT = ROOT / "lib/EpdFont/builtinFonts/source/NotoSans/NotoSans-Regular.ttf"
+
+
+def ink_count(image: Image.Image) -> int:
+    return sum(pixel == 0 for pixel in image.convert("L").getdata())
+
+
+def row_bands(image: Image.Image, *, start_y: int = 50) -> list[tuple[int, int]]:
+    gray = image.convert("L")
+    bands: list[tuple[int, int]] = []
+    active = False
+    for y in range(start_y, gray.height):
+        has_ink = any(gray.getpixel((x, y)) == 0 for x in range(gray.width))
+        if has_ink and not active:
+            band_start = y
+            active = True
+        elif active and not has_ink:
+            bands.append((band_start, y))
+            active = False
+    if active:
+        bands.append((band_start, gray.height))
+    return bands
+
+
+class SugarTvPreviewTest(unittest.TestCase):
+    def test_target_geometry_matches_reference_bands(self) -> None:
+        frame = render(FONT, FrameOptions())
+        self.assertEqual(frame.size, (528, 792))
+        self.assertEqual(frame.mode, "1")
+        self.assertEqual(row_bands(frame), [(139, 192), (297, 462), (551, 630)])
+        self.assertEqual(
+            hashlib.sha256(frame.tobytes()).hexdigest(),
+            "969b8235acdbd4c25038896ebb3694d2e5216c2aa98429e9f94eaea9378af186",
+        )
+
+    def test_prediction_moves_primary_content_up(self) -> None:
+        prediction = "Expected to rise 15-30 mg/dL in 15 minutes"
+        frame = render(FONT, FrameOptions(prediction=prediction, trend="rising_slightly"))
+        bands = row_bands(frame)
+        self.assertLess(bands[0][0], 100)
+        self.assertTrue(any(start >= 630 for start, _ in bands))
+
+    def test_age_density_is_monotonic(self) -> None:
+        current = ink_count(render(FONT, FrameOptions()))
+        aging = ink_count(
+            render(FONT, FrameOptions(age_tier="aging", dim_by_age=True, show_age_states=True))
+        )
+        stale = ink_count(render(FONT, FrameOptions(age_tier="stale", show_age_states=True)))
+        self.assertGreater(current, aging)
+        self.assertGreater(aging, stale)
+        self.assertEqual(
+            render(FONT, FrameOptions()).tobytes(),
+            render(FONT, FrameOptions(age_tier="aging", dim_by_age=False)).tobytes(),
+        )
+        self.assertEqual(
+            render(FONT, FrameOptions()).tobytes(),
+            render(FONT, FrameOptions(age_tier="stale", show_age_states=False)).tobytes(),
+        )
+
+    def test_warning_and_urgent_states_are_distinct(self) -> None:
+        warning = render(FONT, FrameOptions(value="68", zone="low"))
+        urgent = render(FONT, FrameOptions(value="286", zone="urgent_high"))
+        self.assertEqual(warning.getpixel((5, 5)), 0)
+        self.assertGreater(ink_count(urgent), 528 * 792 // 2)
+        self.assertEqual(urgent.getpixel((500, 20)), 255)
+
+    def test_missing_history_and_unknown_trend_render_icons(self) -> None:
+        missing = render(FONT, FrameOptions(delta=None))
+        unknown = render(FONT, FrameOptions(trend="unknown"))
+        self.assertNotEqual(missing.tobytes(), unknown.tobytes())
+        self.assertEqual(missing.getpixel((361, 590)), 0)
+        self.assertEqual(missing.getpixel((308, 590)), 255)
+        unknown_icon = unknown.crop((158, 558, 222, 622))
+        self.assertEqual(
+            hashlib.sha256(unknown_icon.tobytes()).hexdigest(),
+            "daeaedb3cb7f466af5d02e8c59f502e5146ba5d25771bdd8accf5c0075a39eae",
+        )
+
+    def test_every_trend_and_pending_icon_is_nonempty_and_distinct(self) -> None:
+        trends = (
+            "rising_quickly",
+            "rising",
+            "rising_slightly",
+            "steady",
+            "falling_slightly",
+            "falling",
+            "falling_quickly",
+            "unknown",
+        )
+        icons = [
+            render(FONT, FrameOptions(trend=trend)).crop((100, 500, 280, 680))
+            for trend in trends
+        ]
+        icons.append(render(FONT, FrameOptions(delta=None)).crop((245, 500, 425, 680)))
+        for icon in icons:
+            self.assertEqual(icon.convert("L").getextrema(), (0, 255))
+        self.assertEqual(len({icon.tobytes() for icon in icons}), len(icons))
+
+    def test_failed_attempt_changes_only_the_upper_left_status(self) -> None:
+        current = render(FONT, FrameOptions())
+        failed = render(FONT, FrameOptions(update_failed=True))
+        difference = ImageChops.difference(current, failed).getbbox()
+        self.assertIsNotNone(difference)
+        self.assertEqual(difference[0], 24)
+        self.assertLessEqual(difference[2], 250)
+        self.assertLessEqual(difference[3], 100)
+        self.assertEqual(current.crop((0, 100, 528, 792)).tobytes(), failed.crop((0, 100, 528, 792)).tobytes())
+
+    def test_generated_fonts_cover_every_dynamic_character(self) -> None:
+        value_header = (ROOT / "lib/EpdFont/builtinFonts/sugartv_value_108.h").read_text()
+        delta_header = (ROOT / "lib/EpdFont/builtinFonts/sugartv_delta_34.h").read_text()
+        value_labels = set(re.findall(r"// (.+)$", value_header, re.MULTILINE))
+        delta_labels = set(re.findall(r"// (.+)$", delta_header, re.MULTILINE))
+        expected_value = {"+", ",", "-", ".", "/", "A", "N", "U+2212", *map(str, range(10))}
+        expected_delta = {"+", ",", "-", ".", ":", "U+2212", *map(str, range(10))}
+        self.assertTrue(expected_value <= value_labels)
+        self.assertTrue(expected_delta <= delta_labels)
+        self.assertIn("nullptr,", value_header)
+        self.assertIn("nullptr,", delta_header)
+        self.assertIn("// %", (ROOT / "lib/EpdFont/builtinFonts/notosans_8_regular.h").read_text())
+
+    def test_matrix_covers_all_declared_states(self) -> None:
+        matrix = render_matrix(FONT)
+        self.assertEqual(matrix.size, (1056, 1712))
+        self.assertEqual(matrix.mode, "1")
+
+
+if __name__ == "__main__":
+    unittest.main()
