+constexpr GlucoseThresholds MGDL_THRESHOLDS = {54.0F, 70.0F, 180.0F, 250.0F};
+constexpr GlucoseThresholds MMOL_THRESHOLDS = {3.0F, 3.9F, 10.0F, 13.9F};
+
+bool equalThresholds(const GlucoseThresholds& left, const GlucoseThresholds& right) {
+  return left.urgentLow == right.urgentLow && left.low == right.low && left.high == right.high &&
+         left.urgentHigh == right.urgentHigh;
+}
