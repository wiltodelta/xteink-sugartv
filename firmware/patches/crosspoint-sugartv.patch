diff --git a/tools/generate_sugartv_icons.py b/tools/generate_sugartv_icons.py
new file mode 100644
index 00000000..92ca87bc
--- /dev/null
+++ b/tools/generate_sugartv_icons.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Rasterize canonical SugarTV SVG icons into deterministic 1-bit C++ assets."""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+import cairosvg
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[1]
+OUTPUT = ROOT / "src/activities/network/SugarTvIcons.h"
+SIZE = 64
+ICONS = (
+    ("SUGARTV_ARROW_UP", ROOT / "assets/sugartv/mdi-arrow-up.svg"),
+    ("SUGARTV_ARROW_TOP_RIGHT", ROOT / "assets/sugartv/mdi-arrow-top-right.svg"),
+    ("SUGARTV_ARROW_RIGHT", ROOT / "assets/sugartv/mdi-arrow-right.svg"),
+    ("SUGARTV_ARROW_BOTTOM_RIGHT", ROOT / "assets/sugartv/mdi-arrow-bottom-right.svg"),
+    ("SUGARTV_ARROW_DOWN", ROOT / "assets/sugartv/mdi-arrow-down.svg"),
+    ("SUGARTV_CHEVRON_DOUBLE_UP", ROOT / "assets/sugartv/mdi-chevron-double-up.svg"),
+    ("SUGARTV_CHEVRON_DOUBLE_DOWN", ROOT / "assets/sugartv/mdi-chevron-double-down.svg"),
+    ("SUGARTV_HELP_CIRCLE_OUTLINE", ROOT / "assets/sugartv/mdi-help-circle-outline.svg"),
+    ("SUGARTV_PROGRESS_CLOCK", ROOT / "assets/sugartv/mdi-progress-clock.svg"),
+)
+
+
+def rasterize(source: Path) -> list[int]:
+    png = cairosvg.svg2png(url=str(source), output_width=SIZE, output_height=SIZE)
+    image = Image.open(io.BytesIO(png)).convert("RGBA")
+    values = [1 if alpha >= 128 else 0 for *_, alpha in image.getdata()]
+    packed = []
+    for offset in range(0, len(values), 8):
+        byte = sum(bit << (7 - index) for index, bit in enumerate(values[offset : offset + 8]))
+        packed.append(byte)
+    return packed
+
+
+def main() -> None:
+    declarations = []
+    for name, source in ICONS:
+        packed = rasterize(source)
+        rows = [
+            ", ".join(f"0x{byte:02X}" for byte in packed[index : index + 16])
+            for index in range(0, len(packed), 16)
+        ]
+        declarations.append(
+            f"// Generated from {source.relative_to(ROOT)}.\n"
+            f"constexpr uint8_t {name}[] = {{\n  "
+            + ",\n  ".join(rows)
+            + "\n};"
+        )
+    OUTPUT.write_text(
+        "#pragma once\n\n"
+        "#include <cstdint>\n\n"
+        f"constexpr int SUGARTV_ICON_SIZE = {SIZE};\n\n"
+        + "\n\n".join(declarations)
+        + "\n"
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/render_sugartv_frame.cpp b/tools/render_sugartv_frame.cpp
new file mode 100644
index 00000000..4c4fb444
--- /dev/null
+++ b/tools/render_sugartv_frame.cpp
@@ -0,0 +1,114 @@
+#include <builtinFonts/sugartv_battery_8.h>
+#include <builtinFonts/sugartv_delta_34.h>
+#include <builtinFonts/sugartv_prediction_14.h>
+#include <builtinFonts/sugartv_relative_18.h>
+#include <builtinFonts/sugartv_value_108.h>
+
+#include <array>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <string>
+
+#include "activities/network/SugarTvFrameRenderer.h"
+
+namespace {
+
+class HostCanvas final : public sugartv::FrameCanvas {
+ public:
+  void clear(const bool ink) override { pixels.fill(ink); }
+
+  void setPixel(const int x, const int y, const bool ink) override {
+    pixels[static_cast<size_t>(y) * sugartv::FRAME_WIDTH + x] = ink;
+  }
+
+  bool isInk(const int x, const int y) const override {
+    return pixels[static_cast<size_t>(y) * sugartv::FRAME_WIDTH + x];
+  }
+
+  bool writePbm(const std::string& path) const {
+    std::ofstream output(path, std::ios::binary);
+    if (!output) return false;
+    output << "P4\n" << sugartv::FRAME_WIDTH << ' ' << sugartv::FRAME_HEIGHT << "\n";
+    for (int y = 0; y < sugartv::FRAME_HEIGHT; ++y) {
+      for (int byteX = 0; byteX < sugartv::FRAME_WIDTH / 8; ++byteX) {
+        uint8_t byte = 0;
+        for (int bit = 0; bit < 8; ++bit)
+          if (pixels[static_cast<size_t>(y) * sugartv::FRAME_WIDTH + byteX * 8 + bit]) byte |= 1U << (7 - bit);
+        output.put(static_cast<char>(byte));
+      }
+    }
+    return output.good();
+  }
+
+  uint32_t crc32() const {
+    uint32_t crc = 0xFFFFFFFFU;
+    for (const bool pixel : pixels) {
+      crc ^= static_cast<uint8_t>(pixel);
+      for (int bit = 0; bit < 8; ++bit) crc = (crc >> 1) ^ (0xEDB88320U & (0U - (crc & 1U)));
+    }
+    return ~crc;
+  }
+
+ private:
+  std::array<bool, sugartv::FRAME_WIDTH * sugartv::FRAME_HEIGHT> pixels{};
+};
+
+sugartv::Trend trendFrom(const std::string& value) {
+  if (value == "rising_quickly") return sugartv::Trend::RisingQuickly;
+  if (value == "rising") return sugartv::Trend::Rising;
+  if (value == "rising_slightly") return sugartv::Trend::RisingSlightly;
+  if (value == "steady") return sugartv::Trend::Steady;
+  if (value == "falling_slightly") return sugartv::Trend::FallingSlightly;
+  if (value == "falling") return sugartv::Trend::Falling;
+  if (value == "falling_quickly") return sugartv::Trend::FallingQuickly;
+  return sugartv::Trend::Unknown;
+}
+
+sugartv::GlucoseZone zoneFrom(const std::string& value) {
+  if (value == "low" || value == "high") return sugartv::GlucoseZone::Warning;
+  if (value == "urgent_low" || value == "urgent_high") return sugartv::GlucoseZone::Urgent;
+  return sugartv::GlucoseZone::Target;
+}
+
+sugartv::AgeTier ageFrom(const std::string& value) {
+  if (value == "aging") return sugartv::AgeTier::Aging;
+  if (value == "stale") return sugartv::AgeTier::Stale;
+  return sugartv::AgeTier::Current;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc != 16) {
+    std::cerr << "usage: render_sugartv_frame output.pbm time value delta-or-none battery trend zone age "
+                 "relative show-age dim-age thresholds prediction update-failed attempt-time\n";
+    return 64;
+  }
+  const std::string delta = argv[4];
+  const sugartv::FrameFonts fonts{&sugartv_value_108, &sugartv_delta_34, &sugartv_relative_18,
+                                 &sugartv_prediction_14, &sugartv_battery_8};
+  const sugartv::FrameContent content{argv[2],
+                                     argv[3],
+                                     delta == "none" ? nullptr : argv[4],
+                                     argv[13],
+                                     argv[5],
+                                     std::string(argv[14]) == "1" ? argv[15] : nullptr,
+                                     trendFrom(argv[6]),
+                                     zoneFrom(argv[7]),
+                                     ageFrom(argv[8]),
+                                     std::string(argv[9]) == "1",
+                                     std::string(argv[10]) == "1",
+                                     std::string(argv[11]) == "1",
+                                     std::string(argv[12]) == "1"};
+  HostCanvas canvas;
+  const sugartv::FrameStats stats = sugartv::renderFrame(canvas, fonts, content);
+  if (stats.clippedPixels) {
+    std::cerr << "clipped_pixels=" << stats.clippedPixels << '\n';
+    return 2;
+  }
+  if (!canvas.writePbm(argv[1])) return 1;
+  std::cout << "crc32=" << std::hex << canvas.crc32() << std::dec << " bounds=" << stats.minX << ',' << stats.minY << '-'
+            << stats.maxX << ',' << stats.maxY << '\n';
+  return 0;
+}
