+std::string siblingEntityId(const std::string& entityId, const char* valueTail, const char* siblingTail) {
+  const size_t dot = entityId.find('.');
+  if (dot == std::string::npos) return {};
+  const std::string objectId = entityId.substr(dot + 1);
+  const std::string tail(valueTail);
+  if (objectId == tail) return entityId.substr(0, dot + 1) + siblingTail;
+  if (objectId.size() <= tail.size() || objectId.compare(objectId.size() - tail.size(), tail.size(), tail) != 0 ||
+      objectId[objectId.size() - tail.size() - 1] != '_')
+    return {};
+  return entityId.substr(0, dot + 1) + objectId.substr(0, objectId.size() - tail.size()) + siblingTail;
+}
+
+Trend normalizeTrend(const char* raw) {
+  if (!raw) return Trend::Unknown;
+  std::string key = raw;
+  std::transform(key.begin(), key.end(), key.begin(), [](unsigned char c) { return static_cast<char>(tolower(c)); });
+  const size_t first = key.find_first_not_of(" \t\r\n");
+  if (first == std::string::npos) return Trend::Unknown;
+  const size_t last = key.find_last_not_of(" \t\r\n");
+  key = key.substr(first, last - first + 1);
+  if (key == "rising_quickly" || key == "rising quickly" || key == "doubleup" || key == "2" ||
+      key == "increasing_fast" || key == "increasing fast" || key == "up_up" || key == "up_double")
+    return Trend::RisingQuickly;
+  if (key == "rising" || key == "singleup" || key == "3" || key == "increasing" || key == "up")
+    return Trend::Rising;
+  if (key == "rising_slightly" || key == "rising slightly" || key == "fortyfiveup" || key == "4")
+    return Trend::RisingSlightly;
+  if (key == "steady" || key == "flat" || key == "stable" || key == "5" || key == "none")
+    return Trend::Steady;
+  if (key == "falling_slightly" || key == "falling slightly" || key == "fortyfivedown" || key == "6")
+    return Trend::FallingSlightly;
+  if (key == "falling" || key == "singledown" || key == "7" || key == "decreasing" || key == "down")
+    return Trend::Falling;
+  if (key == "falling_quickly" || key == "falling quickly" || key == "doubledown" || key == "8" ||
+      key == "decreasing_fast" || key == "decreasing fast" || key == "down_down" || key == "down_double")
+    return Trend::FallingQuickly;
+  return Trend::Unknown;
+}
+
+float cadenceFromTimestamps(std::vector<time_t> timestamps) {
+  if (timestamps.size() < 2) return 0;
+  std::sort(timestamps.begin(), timestamps.end());
+  timestamps.erase(std::unique(timestamps.begin(), timestamps.end()), timestamps.end());
+  std::vector<float> gaps;
+  for (size_t index = 1; index < timestamps.size(); ++index) {
+    const float gap = static_cast<float>(timestamps[index] - timestamps[index - 1]);
+    if (gap >= 60) gaps.push_back(gap);
+  }
+  if (gaps.empty()) return 0;
+  std::sort(gaps.begin(), gaps.end());
+  return gaps[(gaps.size() - 1) / 2];
+}
+
+AgeTier ageTier(time_t measuredAt, float cadenceSeconds, time_t now) {
+  if (measuredAt == 0) return AgeTier::Stale;
+  const float cadence = cadenceSeconds > 0 ? cadenceSeconds : 5 * 60.0F;
+  const float staleAfter = std::min(cadence * 3.0F, 15 * 60.0F);
+  const float agingAfter = std::min(cadence, staleAfter);
+  const float age = now > measuredAt ? static_cast<float>(now - measuredAt) : 0.0F;
+  if (age > staleAfter) return AgeTier::Stale;
+  if (age > agingAfter) return AgeTier::Aging;
+  return AgeTier::Current;
+}
+
+GlucoseThresholds thresholdsForUnit(bool mmol, const GlucoseThresholds& overrides) {
+  const GlucoseThresholds defaults = mmol ? MMOL_THRESHOLDS : MGDL_THRESHOLDS;
+  GlucoseThresholds resolved = defaults;
+  if (std::isfinite(overrides.urgentLow)) resolved.urgentLow = overrides.urgentLow;
+  if (std::isfinite(overrides.low)) resolved.low = overrides.low;
+  if (std::isfinite(overrides.high)) resolved.high = overrides.high;
+  if (std::isfinite(overrides.urgentHigh)) resolved.urgentHigh = overrides.urgentHigh;
+
+  const bool foreignDefaults = equalThresholds(resolved, mmol ? MGDL_THRESHOLDS : MMOL_THRESHOLDS);
+  const bool ordered = resolved.urgentLow < resolved.low && resolved.low < resolved.high &&
+                       resolved.high < resolved.urgentHigh;
+  return foreignDefaults || !ordered ? defaults : resolved;
+}
+
+GlucoseZone glucoseZone(float value, float urgentLow, float low, float high, float urgentHigh, bool enabled) {
+  if (!enabled || !std::isfinite(value)) return GlucoseZone::Target;
+  if (value < urgentLow || value > urgentHigh) return GlucoseZone::Urgent;
+  if (value < low || value > high) return GlucoseZone::Warning;
+  return GlucoseZone::Target;
+}
+
+}  // namespace sugartv
