--- /dev/null
+++ b/src/activities/network/SugarTvFrameRenderer.cpp
@@ -0,0 +1,297 @@
+#include "SugarTvFrameRenderer.h"
+
+#include "SugarTvIcons.h"
+
+#include <algorithm>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace sugartv {
+namespace {
+
+class Painter {
+ public:
+  explicit Painter(FrameCanvas& canvas) : canvas(canvas) {}
+
+  FrameStats stats;
+
+  void pixel(const int x, const int y, const bool ink) {
+    if (x < 0 || x >= FRAME_WIDTH || y < 0 || y >= FRAME_HEIGHT) {
+      ++stats.clippedPixels;
+      return;
+    }
+    stats.minX = std::min(stats.minX, x);
+    stats.minY = std::min(stats.minY, y);
+    stats.maxX = std::max(stats.maxX, x);
+    stats.maxY = std::max(stats.maxY, y);
+    canvas.setPixel(x, y, ink);
+  }
+
+  void line(int x1, int y1, const int x2, const int y2, const int width, const bool ink) {
+    for (int offset = 0; offset < width; ++offset) lineOne(x1, y1 + offset, x2, y2 + offset, ink);
+  }
+
+  void rect(const int x, const int y, const int width, const int height, const int stroke, const bool ink) {
+    for (int i = 0; i < stroke; ++i) {
+      line(x + i, y + i, x + width - 1 - i, y + i, 1, ink);
+      line(x + width - 1 - i, y + i, x + width - 1 - i, y + height - 1 - i, 1, ink);
+      line(x + width - 1 - i, y + height - 1 - i, x + i, y + height - 1 - i, 1, ink);
+      line(x + i, y + height - 1 - i, x + i, y + i, 1, ink);
+    }
+  }
+
+  void fillRect(const int x, const int y, const int width, const int height, const bool ink) {
+    for (int py = y; py < y + height; ++py)
+      for (int px = x; px < x + width; ++px) pixel(px, py, ink);
+  }
+
+ private:
+  FrameCanvas& canvas;
+
+  void lineOne(int x1, int y1, const int x2, const int y2, const bool ink) {
+    int dx = std::abs(x2 - x1);
+    const int sx = x1 < x2 ? 1 : -1;
+    int dy = -std::abs(y2 - y1);
+    const int sy = y1 < y2 ? 1 : -1;
+    int error = dx + dy;
+    while (true) {
+      pixel(x1, y1, ink);
+      if (x1 == x2 && y1 == y2) break;
+      const int doubled = 2 * error;
+      if (doubled >= dy) {
+        error += dy;
+        x1 += sx;
+      }
+      if (doubled <= dx) {
+        error += dx;
+        y1 += sy;
+      }
+    }
+  }
+};
+
+uint32_t nextCodepoint(const char*& text) {
+  const auto first = static_cast<uint8_t>(*text++);
+  if (first < 0x80) return first;
+  if ((first & 0xE0) == 0xC0) {
+    const uint32_t result = ((first & 0x1F) << 6) | (static_cast<uint8_t>(*text++) & 0x3F);
+    return result;
+  }
+  if ((first & 0xF0) == 0xE0) {
+    const uint8_t second = static_cast<uint8_t>(*text++);
+    const uint8_t third = static_cast<uint8_t>(*text++);
+    const uint32_t result = ((first & 0x0F) << 12) | ((second & 0x3F) << 6) | (third & 0x3F);
+    return result;
+  }
+  return 0;
+}
+
+const EpdGlyph* glyphFor(const EpdFontData& font, const uint32_t codepoint) {
+  for (uint32_t i = 0; i < font.intervalCount; ++i) {
+    const auto& interval = font.intervals[i];
+    if (codepoint >= interval.first && codepoint <= interval.last)
+      return &font.glyph[interval.offset + codepoint - interval.first];
+  }
+  return nullptr;
+}
+
+uint8_t kernClass(const EpdKernClassEntry* entries, const uint16_t count, const uint32_t codepoint) {
+  if (!entries || codepoint > 0xFFFF) return 0;
+  for (uint16_t i = 0; i < count; ++i)
+    if (entries[i].codepoint == codepoint) return entries[i].classId;
+  return 0;
+}
+
+int kerning(const EpdFontData& font, const uint32_t left, const uint32_t right) {
+  if (!font.kernMatrix) return 0;
+  const uint8_t leftClass = kernClass(font.kernLeftClasses, font.kernLeftEntryCount, left);
+  const uint8_t rightClass = kernClass(font.kernRightClasses, font.kernRightEntryCount, right);
+  if (!leftClass || !rightClass) return 0;
+  return font.kernMatrix[(leftClass - 1) * font.kernRightClassCount + rightClass - 1];
+}
+
+int textWidth(const EpdFontData& font, const char* text) {
+  int cursor = 0;
+  int maxX = 0;
+  int32_t previousAdvance = 0;
+  uint32_t previousCodepoint = 0;
+  while (*text) {
+    const uint32_t codepoint = nextCodepoint(text);
+    const EpdGlyph* glyph = glyphFor(font, codepoint);
+    if (!glyph) continue;
+    if (previousCodepoint)
+      cursor += fp4::toPixel(previousAdvance + kerning(font, previousCodepoint, codepoint));
+    maxX = std::max(maxX, cursor + glyph->left + glyph->width);
+    previousAdvance = glyph->advanceX;
+    previousCodepoint = codepoint;
+  }
+  return maxX;
+}
+
+void drawText(Painter& painter, const EpdFontData& font, const int x, const int top, const char* text,
+              const bool ink) {
+  int cursor = x;
+  int32_t previousAdvance = 0;
+  uint32_t previousCodepoint = 0;
+  const int baseline = top + font.ascender;
+  while (*text) {
+    const uint32_t codepoint = nextCodepoint(text);
+    const EpdGlyph* glyph = glyphFor(font, codepoint);
+    if (!glyph) continue;
+    if (previousCodepoint)
+      cursor += fp4::toPixel(previousAdvance + kerning(font, previousCodepoint, codepoint));
+    const uint8_t* bitmap = font.bitmap + glyph->dataOffset;
+    int position = 0;
+    for (int gy = 0; gy < glyph->height; ++gy) {
+      for (int gx = 0; gx < glyph->width; ++gx, ++position) {
+        const uint8_t value = (bitmap[position >> 2] >> ((3 - (position & 3)) * 2)) & 0x3;
+        if (value) painter.pixel(cursor + glyph->left + gx, baseline - glyph->top + gy, ink);
+      }
+    }
+    previousAdvance = glyph->advanceX;
+    previousCodepoint = codepoint;
+  }
+}
+
+void centeredText(Painter& painter, const EpdFontData& font, const int top, const char* text, const bool ink) {
+  drawText(painter, font, (FRAME_WIDTH - textWidth(font, text)) / 2, top, text, ink);
+}
+
+template <int outputSize = SUGARTV_ICON_SIZE>
+void bitmapIcon(Painter& painter, const int cx, const int cy, const uint8_t* bitmap, const bool ink) {
+  const int originX = cx - outputSize / 2;
+  const int originY = cy - outputSize / 2;
+  for (int y = 0; y < outputSize; ++y) {
+    const int sourceY = y * SUGARTV_ICON_SIZE / outputSize;
+    const int sourceRow = sourceY * SUGARTV_ICON_SIZE;
+    for (int x = 0; x < outputSize; ++x) {
+      const int sourceX = x * SUGARTV_ICON_SIZE / outputSize;
+      const int position = sourceRow + sourceX;
+      if ((bitmap[position >> 3] >> (7 - (position & 7))) & 1U) painter.pixel(originX + x, originY + y, ink);
+    }
+  }
+}
+
+void arrow(Painter& painter, const Trend trend, const int cx, const int cy, const bool ink) {
+  static constexpr int trendIconSize = 120;
+  switch (trend) {
+    case Trend::RisingQuickly:
+      bitmapIcon<trendIconSize>(painter, cx, cy, SUGARTV_CHEVRON_DOUBLE_UP, ink);
+      return;
+    case Trend::Rising:
+      bitmapIcon<trendIconSize>(painter, cx, cy, SUGARTV_ARROW_UP, ink);
+      return;
+    case Trend::RisingSlightly:
+      bitmapIcon<trendIconSize>(painter, cx, cy, SUGARTV_ARROW_TOP_RIGHT, ink);
+      return;
+    case Trend::Steady:
+      bitmapIcon<trendIconSize>(painter, cx, cy, SUGARTV_ARROW_RIGHT, ink);
+      return;
+    case Trend::FallingSlightly:
+      bitmapIcon<trendIconSize>(painter, cx, cy, SUGARTV_ARROW_BOTTOM_RIGHT, ink);
+      return;
+    case Trend::Falling:
+      bitmapIcon<trendIconSize>(painter, cx, cy, SUGARTV_ARROW_DOWN, ink);
+      return;
+    case Trend::FallingQuickly:
+      bitmapIcon<trendIconSize>(painter, cx, cy, SUGARTV_CHEVRON_DOUBLE_DOWN, ink);
+      return;
+    case Trend::Unknown:
+      bitmapIcon(painter, cx, cy, SUGARTV_HELP_CIRCLE_OUTLINE, ink);
+      return;
+  }
+}
+
+void progressClock(Painter& painter, const int cx, const int cy, const bool ink) {
+  bitmapIcon(painter, cx, cy, SUGARTV_PROGRESS_CLOCK, ink);
+}
+
+std::vector<std::string> wrap(const EpdFontData& font, const char* text, const int maxWidth) {
+  std::vector<std::string> lines;
+  std::string current;
+  const char* cursor = text;
+  while (*cursor && lines.size() < 2) {
+    while (*cursor == ' ') ++cursor;
+    const char* end = std::strchr(cursor, ' ');
+    std::string word(cursor, end ? end : cursor + std::strlen(cursor));
+    const std::string candidate = current.empty() ? word : current + " " + word;
+    if (!current.empty() && textWidth(font, candidate.c_str()) > maxWidth) {
+      lines.push_back(current);
+      current = word;
+    } else {
+      current = candidate;
+    }
+    if (!end) break;
+    cursor = end + 1;
+  }
+  if (!current.empty() && lines.size() < 2) lines.push_back(current);
+  return lines;
+}
+
+void applyDensity(FrameCanvas& canvas, const uint8_t keepLevels) {
+  static constexpr uint8_t bayer[4][4] = {
+      {0, 8, 2, 10}, {12, 4, 14, 6}, {3, 11, 1, 9}, {15, 7, 13, 5},
+  };
+  for (int y = 0; y < FRAME_HEIGHT; ++y)
+    for (int x = 0; x < FRAME_WIDTH; ++x)
+      if (canvas.isInk(x, y) && bayer[y % 4][x % 4] >= keepLevels) canvas.setPixel(x, y, false);
+}
+
+}  // namespace
+
+FrameStats renderFrame(FrameCanvas& canvas, const FrameFonts& fonts, const FrameContent& content) {
+  Painter painter(canvas);
+  const bool urgent = content.colorThresholds && content.zone == GlucoseZone::Urgent;
+  const bool ink = !urgent;
+  canvas.clear(urgent);
+  const bool hasPrediction = content.predictionText && *content.predictionText;
+  const int verticalOffset = hasPrediction ? 0 : 80;
+
+  centeredText(painter, content.relativeTime ? *fonts.relative : *fonts.delta,
+               (content.relativeTime ? 60 : 35) + verticalOffset, content.timeText, ink);
+  centeredText(painter, *fonts.value, 139 + verticalOffset, content.valueText, ink);
+  arrow(painter, content.trend, 190, 510 + verticalOffset, ink);
+  if (content.deltaText) {
+    const int width = textWidth(*fonts.delta, content.deltaText);
+    drawText(painter, *fonts.delta, 335 - width / 2, 460 + verticalOffset, content.deltaText, ink);
+  } else {
+    progressClock(painter, 335, 510 + verticalOffset, ink);
+  }
+
+  if (hasPrediction) {
+    const auto lines = wrap(*fonts.prediction, content.predictionText, FRAME_WIDTH - 58);
+    const int lineHeight = fonts.prediction->advanceY;
+    const int startY = 680 - static_cast<int>(lines.size() * lineHeight) / 2;
+    for (size_t i = 0; i < lines.size(); ++i)
+      centeredText(painter, *fonts.prediction, startY + static_cast<int>(i) * lineHeight, lines[i].c_str(), ink);
+  }
+
+  if (content.colorThresholds && content.zone == GlucoseZone::Warning)
+    painter.rect(5, 5, FRAME_WIDTH - 10, FRAME_HEIGHT - 10, 5, ink);
+  if (content.showAgeStates) {
+    if (content.ageTier == AgeTier::Stale)
+      applyDensity(canvas, 11);
+    else if (content.ageTier == AgeTier::Aging && content.dimByAge)
+      applyDensity(canvas, 14);
+  }
+
+  const int batteryWidth = textWidth(*fonts.battery, content.batteryText);
+  const int badgeWidth = batteryWidth + 16;
+  const int badgeHeight = fonts.battery->ascender - fonts.battery->descender + 8;
+  const int badgeX = FRAME_WIDTH - 16 - badgeWidth;
+  painter.fillRect(badgeX, 16, badgeWidth, badgeHeight, false);
+  drawText(painter, *fonts.battery, badgeX + 8, 20, content.batteryText, true);
+  if (content.attemptText) {
+    constexpr char failureText[] = "Update failed";
+    const int failureWidth = std::max(textWidth(*fonts.battery, failureText), textWidth(*fonts.battery, content.attemptText));
+    const int failureBadgeWidth = failureWidth + 16;
+    const int failureBadgeHeight = fonts.battery->advanceY * 2 + 8;
+    painter.fillRect(16, 16, failureBadgeWidth, failureBadgeHeight, false);
+    drawText(painter, *fonts.battery, 24, 20, failureText, true);
+    drawText(painter, *fonts.battery, 24, 20 + fonts.battery->advanceY, content.attemptText, true);
+  }
+  return painter.stats;
+}
+
+}  // namespace sugartv
