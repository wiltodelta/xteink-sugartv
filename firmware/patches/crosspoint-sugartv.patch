+
+#include "activities/network/SugarTvLogic.h"
+
+using sugartv::AgeTier;
+using sugartv::GlucoseZone;
+using sugartv::GlucoseThresholds;
+using sugartv::Trend;
+
+int main() {
+  const time_t utc = sugartv::parseTimestampText("2026-08-09T04:03:47Z");
+  assert(utc != 0);
+  assert(sugartv::parseTimestampText("2026-08-08T21:03:47-07:00") == utc);
+  assert(sugartv::parseTimestampText("2026-08-09T11:03:47+07:00") == utc);
+  assert(sugartv::parseTimestampText("2026-08-09T04:03:47.987+00:00") == utc);
+  assert(sugartv::parseTimestampText("1786248227") == utc);
+  assert(sugartv::parseTimestampText("1786248227000") == utc);
+  assert(sugartv::parseTimestampText("2026-08-08T21:03:47-07:00") >
+         sugartv::parseTimestampText("2026-08-08T21:03:47+07:00"));
+  assert(sugartv::parseTimestampText(nullptr) == 0);
+  assert(sugartv::parseTimestampText("garbage") == 0);
+  assert(sugartv::parseTimestampText("2026-02-30T00:00:00Z") == 0);
+  assert(sugartv::parseTimestampText("2026-08-09T04:03:47.Z") == 0);
+  assert(sugartv::parseTimestampText("2026-08-09T04:03:47Zjunk") == 0);
+  assert(sugartv::parseTimestampText("2026-08-09T04:03:47+7:00") == 0);
+  assert(sugartv::parseTimestampText("2026-08-09T04:03:47+24:00") == 0);
+
+  assert(sugartv::siblingEntityId("sensor.glucose_value", "glucose_value", "glucose_trend") ==
+         "sensor.glucose_trend");
+  assert(sugartv::siblingEntityId("sensor.alice_glucose_value", "glucose_value", "glucose_trend") ==
+         "sensor.alice_glucose_trend");
+  assert(sugartv::siblingEntityId("sensor.alice_other", "glucose_value", "glucose_trend").empty());
+
+  assert(sugartv::normalizeTrend("DoubleUp") == Trend::RisingQuickly);
+  assert(sugartv::normalizeTrend(" increasing ") == Trend::Rising);
+  assert(sugartv::normalizeTrend("FortyFiveUp") == Trend::RisingSlightly);
+  assert(sugartv::normalizeTrend("5") == Trend::Steady);
+  assert(sugartv::normalizeTrend("falling slightly") == Trend::FallingSlightly);
+  assert(sugartv::normalizeTrend("singleDown") == Trend::Falling);
+  assert(sugartv::normalizeTrend("down_double") == Trend::FallingQuickly);
+  assert(sugartv::normalizeTrend("unavailable") == Trend::Unknown);
+  assert(sugartv::normalizeTrend(nullptr) == Trend::Unknown);
+
+  assert(sugartv::cadenceFromTimestamps({0, 300, 900, 1200}) == 300.0F);
+  assert(sugartv::cadenceFromTimestamps({0, 30, 300, 600}) == 270.0F);
+  assert(sugartv::cadenceFromTimestamps({600, 0, 300, 300}) == 300.0F);
+  assert(sugartv::cadenceFromTimestamps({0, 300, 600, 690, 900, 1200}) == 300.0F);
+  assert(sugartv::cadenceFromTimestamps({0, 30}) == 0.0F);
+
+  constexpr time_t now = 10'000;
+  assert(sugartv::ageTier(now - 60, 300, now) == AgeTier::Current);
+  assert(sugartv::ageTier(now - 360, 300, now) == AgeTier::Aging);
+  assert(sugartv::ageTier(now - 960, 300, now) == AgeTier::Stale);
+  assert(sugartv::ageTier(now - 120, 60, now) == AgeTier::Aging);
+  assert(sugartv::ageTier(now - 240, 60, now) == AgeTier::Stale);
+  assert(sugartv::ageTier(now - 901, 1200, now) == AgeTier::Stale);
+  assert(sugartv::ageTier(0, 300, now) == AgeTier::Stale);
+  assert(sugartv::ageTier(now + 60, 300, now) == AgeTier::Current);
+
+  const GlucoseThresholds noOverrides = {NAN, NAN, NAN, NAN};
+  const GlucoseThresholds mgdlDefaults = sugartv::thresholdsForUnit(false, noOverrides);
+  assert(mgdlDefaults.urgentLow == 54 && mgdlDefaults.low == 70 && mgdlDefaults.high == 180 &&
+         mgdlDefaults.urgentHigh == 250);
+  const GlucoseThresholds partial = sugartv::thresholdsForUnit(false, {NAN, 75, NAN, NAN});
+  assert(partial.urgentLow == 54 && partial.low == 75 && partial.high == 180 && partial.urgentHigh == 250);
+  const GlucoseThresholds invalid = sugartv::thresholdsForUnit(false, {NAN, 190, NAN, NAN});
+  assert(invalid.urgentLow == 54 && invalid.low == 70 && invalid.high == 180 && invalid.urgentHigh == 250);
+  const GlucoseThresholds foreign = sugartv::thresholdsForUnit(true, {54, 70, 180, 250});
+  assert(foreign.urgentLow == 3.0F && foreign.low == 3.9F && foreign.high == 10.0F &&
+         foreign.urgentHigh == 13.9F);
+
+  assert(sugartv::glucoseZone(53, 54, 70, 180, 250, true) == GlucoseZone::Urgent);
+  assert(sugartv::glucoseZone(54, 54, 70, 180, 250, true) == GlucoseZone::Warning);
+  assert(sugartv::glucoseZone(69, 54, 70, 180, 250, true) == GlucoseZone::Warning);
+  assert(sugartv::glucoseZone(70, 54, 70, 180, 250, true) == GlucoseZone::Target);
+  assert(sugartv::glucoseZone(180, 54, 70, 180, 250, true) == GlucoseZone::Target);
+  assert(sugartv::glucoseZone(181, 54, 70, 180, 250, true) == GlucoseZone::Warning);
+  assert(sugartv::glucoseZone(250, 54, 70, 180, 250, true) == GlucoseZone::Warning);
+  assert(sugartv::glucoseZone(251, 54, 70, 180, 250, true) == GlucoseZone::Urgent);
+  assert(sugartv::glucoseZone(300, 54, 70, 180, 250, false) == GlucoseZone::Target);
+}
