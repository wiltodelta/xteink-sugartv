# Legacy reference server configuration. The direct firmware does not read
# this file. Run the server without Home Assistant using a synthetic reading.
XTEINK_MOCK=true

# Shared secret returned to the device during TRMNL provisioning.
# Change this before exposing the service beyond a trusted development LAN.
XTEINK_API_KEY=change-me

# Optional. Restrict provisioning and display requests to one X3 Wi-Fi MAC.
# XTEINK_DEVICE_ID=AA:BB:CC:DD:EE:FF

# Optional. Use this when the request address is not reachable from the X3.
# x3-trmnl currently requires HTTPS, including for image downloads.
# XTEINK_PUBLIC_BASE_URL=https://192.168.1.10:8443

# Home Assistant mode. Set XTEINK_MOCK=false and fill all three values.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# HA_ENTITY_ID=sensor.jane_glucose_value

# Optional overrides for integrations that cannot be auto-detected.
# HA_TREND_ENTITY_ID=sensor.jane_glucose_trend
# HA_TIMESTAMP_ATTRIBUTE=measurement_timestamp

# The X3 wakes and checks for a new frame at this interval.
XTEINK_REFRESH_SECONDS=60

# SugarTV display options. Defaults match the card, except that this standalone
# device needs an explicit locale because it has no Home Assistant user profile.
XTEINK_LOCALE=ru
XTEINK_SHOW_PREDICTION=true
XTEINK_RELATIVE_TIME=false
XTEINK_DIM_BY_AGE=false
XTEINK_COLOR_THRESHOLDS=true

# Optional thresholds. Use values in the glucose entity's own unit. Omitted
# values use SugarTV's mg/dL or mmol/L defaults automatically.
# XTEINK_URGENT_LOW=54
# XTEINK_LOW=70
# XTEINK_HIGH=180
# XTEINK_URGENT_HIGH=250

# Optional when the host has no Arial, DejaVu Sans, or Noto Sans in a common path.
# XTEINK_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
